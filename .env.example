# =============================================================================
# Lolilota 环境变量示例
# 复制为 .env 后按需修改；也可以直接配置到服务器环境变量里。
# 优先级：环境变量 > config/config.php 的默认值
# =============================================================================

# ---- 应用 -------------------------------------------------------------------
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# 允许跨域的前端来源（逗号分隔）。同源部署留空；扩展形态会自动放行
# chrome-extension:// / moz-extension:// 来源，无需在此列出。
APP_ORIGINS=

# 多机部署时固定一个密钥；留空会在 var/secret.key 自动生成
APP_SECRET=

# ---- 存储与日志 -------------------------------------------------------------
STORAGE_DRIVER=json
HISTORY_MAX=500
HISTORY_PUSH_MAX=200

# 打开后会把与 Cdifit 的请求/响应结构写入 var/logs/cdifit.log
# 用途：核对文档字段。含结构信息，排查完请关闭。
CDIFIT_TRACE=false

# ---- 账号系统 ---------------------------------------------------------------
# 可用的登录方式：cdifit（对接 Cdifit 账号系统）、local（本地账号，兜底/离线）
AUTH_PROVIDERS=cdifit,local
AUTH_DEFAULT=cdifit
AUTH_AUTO_PROVISION=true
AUTH_ALLOW_SELF_REGISTER=false

SESSION_TTL=1209600
SESSION_REFRESH_TTL=2592000

# ---- Cdifit 对接 ------------------------------------------------------------
# 服务地址：填写实际提供这四个会话接口的地址
CDIFIT_BASE_URL=https://www.cdifit.cn
CDIFIT_API_PREFIX=/api
CDIFIT_SESSION_PREFIX=/session

# 四个接口路径（对应 docs.cdifit.com/zh 的会话接口）
CDIFIT_EP_PASSWORD=/password_sign_in
CDIFIT_EP_2FA=/finish_sign_in_with_2fa
CDIFIT_EP_REFRESH=/refresh_token
CDIFIT_EP_SIGNOUT=/sign_out

# 认证方式：bearer | api_key_header | query | none
CDIFIT_AUTH_TYPE=bearer
CDIFIT_API_TOKEN=
CDIFIT_AUTH_HEADER=Authorization
CDIFIT_AUTH_SCHEME=Bearer
CDIFIT_AUTH_QUERY_KEY=access_token

CDIFIT_TIMEOUT=15
CDIFIT_VERIFY_TLS=true

# ---- Cdifit 字段映射（文档字段与默认不符时改这里，不用改代码）--------------
# 登录请求里账号字段名：email / username / account / login
CDIFIT_F_IDENTIFIER=email
CDIFIT_F_PASSWORD=password
CDIFIT_F_CODE=code
CDIFIT_F_CHALLENGE=challenge_id
CDIFIT_F_TICKET=ticket
CDIFIT_F_REFRESH=refresh_token
CDIFIT_F_REMEMBER=remember
CDIFIT_F_DEVICE=device
CDIFIT_F_TOKEN=token
