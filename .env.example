# =============================================================================
# Lolilota 环境变量示例
# 复制为 .env 后按需修改；也可以直接配置到服务器环境变量里。
# 优先级：环境变量 > config/config.php 的默认值
# =============================================================================

# ---- 应用 -------------------------------------------------------------------
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai

# 站点首页 / 扩展主页（必须是 https:// 开头的绝对 URL）
# 默认使用 Lolilota 官方站点；自建部署时改成自己的域名。
APP_HOMEPAGE=https://lolilota.520world.top/

# 允许跨域的前端来源（逗号分隔）。同源部署留空；扩展形态会自动放行
# chrome-extension:// / moz-extension:// 来源，无需在此列出。
APP_ORIGINS=

# 多机部署时固定一个密钥；留空会在 var/secret.key 自动生成
APP_SECRET=

# ---- 存储与日志 -------------------------------------------------------------
STORAGE_DRIVER=json
HISTORY_MAX=500
HISTORY_PUSH_MAX=200

# 打开后会把与 Cdifit 的请求/响应结构写入 var/logs/cdifit.log
# 用途：核对文档字段。含结构信息，排查完请关闭。
CDIFIT_TRACE=false

# ---- 账号系统 ---------------------------------------------------------------
# 可用的登录方式：cdifit（对接 Cdifit 账号系统）、local（本地账号，兜底/离线）
AUTH_PROVIDERS=cdifit,local
AUTH_DEFAULT=cdifit
AUTH_AUTO_PROVISION=true
AUTH_ALLOW_SELF_REGISTER=false

SESSION_TTL=1209600
SESSION_REFRESH_TTL=2592000

# ---- Cdifit 对接（Cloudreve 风格的接口）-------------------------------------
# 路由前缀是 /api/v4/，HTTP 状态固定 200，结果由 JSON 里的 code 表示：
#   0 = 成功     203 = 需要两步验证     40020/40021/40069 = 邮箱或密码错误
#
# 服务地址请不要提交进仓库：要么写在这里（.env 已被忽略），
# 要么写进 config/local.php（同样被忽略）。
CDIFIT_LABEL=Cdifit 账号
CDIFIT_BASE_URL=
CDIFIT_API_PREFIX=/api/v4
CDIFIT_SESSION_PREFIX=/session
CDIFIT_USER_PREFIX=/user

# 四个会话接口（HTTP 方法固定：POST / POST / PUT / DELETE）
CDIFIT_EP_PASSWORD=/token
CDIFIT_EP_2FA=/token/2fa
CDIFIT_EP_REFRESH=/token/refresh
CDIFIT_EP_SIGNOUT=/token
CDIFIT_EP_PROFILE=/profile

# 调用 Cdifit 的服务级认证：none（默认）| bearer | api_key_header
# 登录与刷新用的是请求自身的凭据，通常不需要服务令牌
CDIFIT_AUTH_TYPE=none
CDIFIT_API_TOKEN=
CDIFIT_AUTH_HEADER=Authorization
CDIFIT_AUTH_SCHEME=Bearer

CDIFIT_TIMEOUT=15
CDIFIT_VERIFY_TLS=true

# ---- Cdifit 字段映射（与本项目默认值一致，一般无需修改）---------------------
CDIFIT_F_EMAIL=email
CDIFIT_F_PASSWORD=password
CDIFIT_F_CAPTCHA=captcha
CDIFIT_F_CAPTCHA_TICKET=ticket
CDIFIT_F_SESSION=session
CDIFIT_F_CODE=code
CDIFIT_F_REFRESH=refresh_token
