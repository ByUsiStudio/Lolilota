# ---- 依赖 ----
node_modules/
.npm-cache/
composer.lock

# 说明：css/lolilota.css、dist/、public/ 的前端资源都属于「构建产物」，
# 但本仓库刻意把它们一起提交：
#   - 浏览器扩展加载 dist/，clone 下来就能用，不需要 Node.js；
#   - PHP 站点也不需要构建步骤，public/router.php 在开发模式下还能按需编译样式。
# 改完 src/ 之后，用下面任一方式刷新产物：
#   php bin/build.php          纯 PHP（无 Node）
#   npm run build              完整打包（含扩展目录与占位符替换）

# ---- PHP 运行时数据：会话、账号、历史、日志、样式缓存 ----
# 注意：不要写成 /bin，否则 bin/lolilota 等命令行工具会被忽略。
var/
storage/
*.sqlite
*.sqlite3

# ---- 本地环境配置（只提交 *.example.php 与 .env.example）----
# config/local.php 里放站点域名、Cdifit 服务地址等部署相关值，绝不提交。
.env
.env.local
config/local.php
config/config.local.php
config/*.local.php

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
out.txt
err.txt
