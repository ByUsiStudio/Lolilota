# ---- 依赖 ----
node_modules/
.npm-cache/
composer.lock

# ---- 构建产物（由 npm run build 生成）----
# dist/ 是浏览器扩展加载目录，public/ 是 PHP 站点根目录，两者都由 src/ 构建而来。
# 部署到虚拟主机时先 npm run build，再上传产物；不要把产物提交进仓库。
dist/
css/lolilota.css
css/lolilota.css.map

# ---- 历史遗留文件（新结构已不再使用，确认无误后可删除）----
css/style.css
js/
lib/
icons/
newtab.html

# ---- PHP 运行时数据：会话、账号、历史、日志 ----
# 注意：不要写成 /bin，否则 bin/lolilota 命令行工具会被忽略。
var/
storage/
*.sqlite
*.sqlite3

# ---- 本地环境配置（只提交 .env.example）----
.env
.env.local
config/config.local.php
config/*.local.php

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
out.txt
err.txt
