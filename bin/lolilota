#!/usr/bin/env php
<?php
/**
 * Lolilota 命令行工具
 *
 * 用法：
 *   php bin/lolilota list
 *   php bin/lolilota create-user <用户名> <密码> [邮箱]
 *   php bin/lolilota reset-password <用户名> <新密码>
 *   php bin/lolilota delete-user <用户名>
 *   php bin/lolilota gc                       清理过期会话与令牌
 *   php bin/lolilota doctor                   自检环境与 Cdifit 配置
 */

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "本脚本只能在命令行运行\n");
    exit(1);
}

require dirname(__DIR__) . '/public/bootstrap.php';

use Lolilota\Core\Config;
use Lolilota\Core\Security;
use Lolilota\Core\SessionManager;
use Lolilota\Repository\HistoryRepository;
use Lolilota\Repository\UserRepository;

const CLI_NAME = 'lolilota';

function out(string $message = ''): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

function fail(string $message): never
{
    fwrite(STDERR, "\033[31m✗\033[0m " . $message . PHP_EOL);
    exit(1);
}

function ok(string $message): void
{
    fwrite(STDOUT, "\033[32m✓\033[0m " . $message . PHP_EOL);
}

/**
 * @return array<string, mixed>|null
 */
function findUser(UserRepository $users, string $identifier): ?array
{
    return str_contains($identifier, '@')
        ? $users->findByEmail($identifier)
        : $users->findByUsername($identifier);
}

// ---------------------------------------------------------------------------

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'help';

$users = new UserRepository();

switch ($command) {
    case 'list':
        $all = $users->all();
        if ($all === []) {
            out('还没有任何账号。用 create-user 建一个，或让 Cdifit 登录自动建档。');
            break;
        }
        out(sprintf('%-28s %-18s %-26s %s', 'ID', '用户名', '邮箱', '来源'));
        out(str_repeat('-', 90));
        foreach ($all as $user) {
            out(sprintf(
                '%-28s %-18s %-26s %s',
                (string) ($user['id'] ?? '-'),
                (string) ($user['username'] ?? '-'),
                (string) ($user['email'] ?? '-'),
                (string) ($user['provider'] ?? 'local')
            ));
        }
        out();
        out('共 ' . count($all) . ' 个账号');
        break;

    case 'create-user':
        $username = (string) ($argv[2] ?? '');
        $password = (string) ($argv[3] ?? '');
        $email = (string) ($argv[4] ?? '');

        if ($username === '' || $password === '') {
            fail('用法：php bin/lolilota create-user <用户名> <密码> [邮箱]');
        }
        if (strlen($password) < 8) {
            fail('密码至少 8 位');
        }
        if (findUser($users, $username) !== null) {
            fail('账号已存在：' . $username);
        }

        $user = $users->createLocal($username, $password, $email !== '' ? ['email' => $email] : []);
        ok('已创建账号：' . $username . ' (id=' . $user['id'] . ')');
        break;

    case 'reset-password':
        $username = (string) ($argv[2] ?? '');
        $password = (string) ($argv[3] ?? '');

        if ($username === '' || $password === '') {
            fail('用法：php bin/lolilota reset-password <用户名> <新密码>');
        }
        if (strlen($password) < 8) {
            fail('密码至少 8 位');
        }

        $user = findUser($users, $username);
        if ($user === null) {
            fail('账号不存在：' . $username);
        }

        $users->setPassword((string) $user['id'], Security::hashPassword($password));
        ok('已重置密码：' . $username);
        break;

    case 'delete-user':
        $username = (string) ($argv[2] ?? '');
        if ($username === '') {
            fail('用法：php bin/lolilota delete-user <用户名>');
        }

        $user = findUser($users, $username);
        if ($user === null) {
            fail('账号不存在：' . $username);
        }

        $uid = (string) $user['id'];
        $users->forget($uid);
        (new HistoryRepository())->clear($uid);
        ok('已删除账号及其历史：' . $username);
        break;

    case 'gc':
        $removed = (new SessionManager())->gc();
        ok('已清理 ' . $removed . ' 条过期会话 / 令牌');
        break;

    case 'doctor':
        out('Lolilota 环境自检');
        out(str_repeat('=', 52));

        out('PHP 版本：' . PHP_VERSION);
        PHP_VERSION_ID >= 80100 ? ok('版本满足要求（>= 8.1）') : fail('需要 PHP 8.1 以上');

        function_exists('curl_init') ? ok('cURL 扩展可用（推荐）') : out('- 未启用 cURL，将使用流封装器');
        extension_loaded('openssl') ? ok('openssl 可用（https 必需）') : out('! 未启用 openssl：无法访问 https 的 Cdifit 服务');
        extension_loaded('mbstring') ? ok('mbstring 可用') : out('! 未启用 mbstring：中文关键词长度限制可能不准');
        defined('PASSWORD_BCRYPT') ? ok('password_hash 可用') : out('- 使用内置 PBKDF2 散列');

        $storeDir = (string) Config::get('storage.path', LOLILOTA_VAR . '/store');
        is_dir($storeDir) || @mkdir($storeDir, 0775, true);
        is_writable($storeDir) ? ok('数据目录可写：' . $storeDir) : fail('数据目录不可写：' . $storeDir);

        $secretFile = LOLILOTA_VAR . '/secret.key';
        if (is_file($secretFile)) {
            ok('会话密钥已生成：' . $secretFile);
        } else {
            Security::secret();
            is_file($secretFile)
                ? ok('会话密钥已生成：' . $secretFile)
                : out('! 会话密钥无法写入 ' . LOLILOTA_VAR . '，请配置 APP_SECRET 环境变量');
        }

        out();
        out('账号与存储');
        out(str_repeat('-', 52));
        out('已注册账号：' . count($users->all()));
        out('有效会话数：' . (new SessionManager())->activeCount());
        out('存储驱动：' . (string) Config::get('storage.driver', 'json'));

        out();
        out('Cdifit 配置');
        out(str_repeat('-', 52));
        $base = (string) Config::get('cdifit.base_url', '');
        $apiPrefix = '/' . trim((string) Config::get('cdifit.api_prefix', '/api/v4'), '/');
        $sessionPrefix = trim((string) Config::get('cdifit.session_prefix', '/session'), '/');
        $userPrefix = trim((string) Config::get('cdifit.user_prefix', '/user'), '/');
        $userEndpoints = (array) Config::get('cdifit.user_endpoints', ['user_profile']);

        out('服务地址：' . ($base !== '' ? $base : '（未配置）'));
        foreach ((array) Config::get('cdifit.endpoints', []) as $name => $path) {
            $group = in_array($name, $userEndpoints, true) ? $userPrefix : $sessionPrefix;
            $full = $base . $apiPrefix . ($group !== '' ? '/' . $group : '') . $path;
            out(sprintf('  %-26s %s', $name, $full));
        }
        out('请求追踪：' . ((bool) Config::get('log.cdifit_trace', false) ? '已开启（CDIFIT_TRACE=true）' : '关闭'));
        out();
        out('提示：连接真实服务做一次登录验证：');
        out('      php bin/lolilota cdifit:probe <邮箱> <密码>');
        out('      失败时打开 CDIFIT_TRACE=true 复现，再看 var/logs/cdifit.log 的结构。');
        break;

    case 'cdifit:probe':
        // 用真实账号打一次 Cdifit 接口，打印请求/响应结构，用于联调
        $email = (string) ($argv[2] ?? '');
        $password = (string) ($argv[3] ?? '');

        if ($email === '' || $password === '') {
            fail('用法：php bin/lolilota cdifit:probe <邮箱> <密码>');
        }

        $provider = new \Lolilota\Auth\CdifitProvider();

        out('Cdifit 联调');
        out(str_repeat('=', 52));
        out('服务地址：' . (string) Config::get('cdifit.base_url'));
        out('登录接口：POST '
            . rtrim((string) Config::get('cdifit.base_url'), '/')
            . '/' . trim((string) Config::get('cdifit.api_prefix', '/api/v4'), '/')
            . '/' . trim((string) Config::get('cdifit.session_prefix', '/session'), '/')
            . (string) Config::get('cdifit.endpoints.password_sign_in'));
        out();

        if (!extension_loaded('openssl') && str_starts_with((string) Config::get('cdifit.base_url'), 'https://')) {
            out('! 当前 PHP 未启用 openssl，无法访问 https 服务。');
            out('  请在 php.ini 中开启 extension=openssl 后重试，或改用 http 地址。');
            out();
        }

        // 打开追踪，把真实结构写进 var/logs/cdifit.log
        putenv('CDIFIT_TRACE=true');
        Config::load(require LOLILOTA_CONFIG_DIR . '/config.php');

        try {
            $result = $provider->passwordSignIn(['email' => $email, 'password' => $password]);

            if ($result->needsTwoFactor()) {
                ok('登录成功，但账号开启了两步验证');
                out('  2FA 会话 ID：' . (string) ($result->challenge['session'] ?? '(未取到)'));
                out('  接着调用 POST /api/v4/session/token/2fa：{ "session": "...", "code": "123456" }');
            } else {
                ok('登录成功，成功拿到令牌');
                $tokens = $provider->lastTokens();
                out('  access_token  ：' . (isset($tokens['access_token']) ? '已获取（' . strlen((string) $tokens['access_token']) . ' 字节）' : '缺失'));
                out('  refresh_token ：' . (isset($tokens['refresh_token']) ? '已获取' : '缺失'));
                if (isset($tokens['expires_at'])) {
                    out('  access 过期于 ：' . date('Y-m-d H:i:s', (int) $tokens['expires_at']));
                }
                if (isset($tokens['refresh_expires_at'])) {
                    out('  refresh 过期于：' . date('Y-m-d H:i:s', (int) $tokens['refresh_expires_at']));
                }

                $user = $result->user ?? [];
                out('  用户：' . json_encode($user, JSON_UNESCAPED_UNICODE));
            }
        } catch (\Lolilota\Auth\AuthException $e) {
            fail($e->getMessage() . '（errorCode=' . $e->errorCode . '）');
        } catch (\Throwable $e) {
            fail($e->getMessage());
        }

        out();
        out('详细结构已写入 var/logs/cdifit.log（敏感值已打码）');
        break;

    case 'help':
    default:
        out('Lolilota 命令行工具');
        out();
        out('  php bin/lolilota list                            列出账号');
        out('  php bin/lolilota create-user <用户名> <密码> [邮箱]  新建本地账号');
        out('  php bin/lolilota reset-password <用户名> <新密码>    重置密码');
        out('  php bin/lolilota delete-user <用户名>              删除账号及其历史');
        out('  php bin/lolilota gc                              清理过期会话');
        out('  php bin/lolilota doctor                          环境与配置自检');
        out('  php bin/lolilota cdifit:probe <邮箱> <密码>       用真实账号联调 Cdifit');
        break;
}
