{
  "manifest_version": 3,
  "name": "Lolilota 洛丽洛塔 - 启始页",
  "short_name": "Lolilota",
  "version": "1.0.0",
  "description": "简洁清新的 Bing 搜索启始页：实时搜索建议、本地搜索历史（导入/导出），自动接管新标签页与主页。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "host_permissions": [
    "*://api.bing.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lolilota@byusistudio",
      "strict_min_version": "115.0"
    }
  }
}
