{
    "manifest_version": 3,
    "name": "Lolilota 洛丽洛塔 - 启始页",
    "short_name": "Lolilota",
    "version": "1.1.0",
    "description": "简洁清新的 Bing 搜索启始页：实时搜索建议、搜索历史（导入/导出/跨设备同步）、Cdifit 账号登录。",
    "icons": {
        "16": "dist/icons/icon16.png",
        "48": "dist/icons/icon48.png",
        "128": "dist/icons/icon128.png"
    },
    "chrome_url_overrides": {
        "newtab": "dist/newtab.html"
    },
    "chrome_settings_overrides": {
        "homepage": "https://lolilota.app/"
    },
    "host_permissions": [
        "*://api.bing.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "lolilota@byusistudio",
            "strict_min_version": "115.0"
        }
    }
}
