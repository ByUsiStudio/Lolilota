{
  "name": "lolilota",
  "version": "1.1.0",
  "private": true,
  "description": "Lolilota 洛丽洛塔 —— Bing 搜索启始页（浏览器扩展 + PHP 后端服务）",
  "license": "MIT",
  "author": "ByUsi Studio",
  "homepage": "https://github.com/byusistudio/lolilota",
  "keywords": [
    "newtab",
    "startpage",
    "browser-extension",
    "less",
    "php"
  ],
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "scripts": {
    "build": "node build.cjs",
    "build:dev": "node build.cjs --dev",
    "build:dist": "node build.cjs --dist",
    "dev": "node build.cjs --watch",
    "watch": "node build.cjs --watch",
    "start": "node build.cjs --watch",
    "serve": "php -S 127.0.0.1:8787 -t public public/router.php",
    "cli": "php bin/lolilota",
    "lint:php": "php bin/lolilota doctor",
    "test": "powershell -ExecutionPolicy Bypass -File tests/smoke.ps1"
  },
  "devDependencies": {
    "less": "^4.2.0"
  }
}
